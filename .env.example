# Chimera environment configuration template.
# Copy to .env (gitignored) and fill the keys.

# ── Required for any model call ──────────────────────────
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ── HTTP MCP server (v2.6 / v4.52) ───────────────────────
# CHIMERA_PEER_TOKEN is REQUIRED when serve_http binds to a non-loopback
# host (anything but 127.0.0.1, ::1, localhost). Generate a random one:
#   python -c "import secrets; print('tok_' + secrets.token_hex(16))"
# CHIMERA_PEER_TOKEN=tok_...

# Multi-tenant alternative: JSON map of token → peer_name.
# CHIMERA_PEER_TOKENS={"tok_abc": "peerA", "tok_def": "peerB"}

# Explicit override to allow non-loopback bind WITHOUT auth (rare; CI /
# sandboxed networks). Not recommended in production.
# CHIMERA_ALLOW_INSECURE_HTTP=0

# ── Loop tuning (optional) ───────────────────────────────
# CHIMERA_CYCLE_SECONDS=900           # default seconds per cycle in long-run
# CHIMERA_OPUS_PLAN_EVERY_N=4         # opus-tier PLAN cadence
# CHIMERA_SESSION_MAX_HOURS=12        # session rotation horizon

# ── Engines (v1.1 — discovery/curiosity/reflection) ──────
# Set to 0 to disable ALL three engines + Opus PLAN.
# CHIMERA_ENGINES_ENABLED=1

# ── Housekeeping (v4.24 / v4.32) ─────────────────────────
# CHIMERA_AUTO_ARCHIVE_DISABLED=0
# CHIMERA_AUTO_ARCHIVE_AFTER_CYCLES=30
# CHIMERA_AUTO_GRAPH_UPDATE_DISABLED=0

# ── State / mind dirs (optional override) ────────────────
# CHIMERA_STATE_DIR=./state
# CHIMERA_MIND_DIR=./mind
# CHIMERA_PEER_REGISTRY_DIR=~/.chimera/peers
# CHIMERA_PROTOCOL_JOURNAL_DIR=./state/protocol_journal
# CHIMERA_PEER_TRUST_JOURNAL_DIR=./state/peer_trust_journal

# ── Peer federation sync (v3.7+) ─────────────────────────
# CHIMERA_REMOTE_PEERS=https://peerA.example.com:8765,https://peerB.example.com:8765

# ── Outbound MCP servers (v2.x peer client) ──────────────
# JSON map; see chimera.tools.parse_mcp_config.
# CHIMERA_MCP_SERVERS={"peer_alpha": {"transport": "http", "url": "https://alpha:8765/mcp", "token": "tok_..."}}

# ── Tool gates (v3.6 doctor) ─────────────────────────────
# CHIMERA_GLOBAL_TOOL_DENY=spawn_sub_agent  # comma-separated names
